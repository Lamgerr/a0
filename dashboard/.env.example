# a0 dashboard — build-time env (Vercel project settings or .env.local)
# Control plane: Supabase project URL + publishable (anon) key. Absent env
# boots the panel in local mode: everything browsable, demo data only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where a wing serves /v1/* in dev (default http://localhost:8082)
VITE_A0_BASE_URL=http://localhost:8082
